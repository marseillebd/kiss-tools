main() {
  loop {
    c = getchar()

    if (c < 0) break
    isComment = c == '#'
    isComment |= c == ';'
    isComment |= c == '@'
    if !(isComment == 0) {
      skipComment()
      continue
    }
    if (c == ' ') continue

    b = fromHex(c)
    b <<= 4
    c = getchar()
    c = fromHex(c2)
    b += c

    putchar(b)
  }

  exit(0)
}


skipLine() {
  loop {
    c = getchar()
    if (c == EOF) return
    if (c == '\n') return
  }

}



fromHex(c) {
  if (c < '0') exit(1)
  if (c <= '9') {
    c -= '0'
    return c
  }
  if (c > 'F') {
    c -= 'a' - 'A'
  }
  if (c < 'A') exit(1)
  if (c > 'F') exit(1)
  c -= 'A' - 10
  return c
}
