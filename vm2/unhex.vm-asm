@main:
  @main.loop:
    in $1

    jneg $1 @main.loop.end      ; imm {@main.loop.end - $$}; jltz $1 $0
    cmp $1 '#' eq add 1 0 $2    ; imm '#'; cmp eq $1 $0; imm 1; add $1 $0 $2
    cmp $1 ';' eq add 1 $2 $2   ; imm ';'; cmp eq $1 $0; imm 1; add $1 $2 $2
    cmp $1 '@' eq add 1 $2 $2   ; imm '#'; cmp eq $1 $0; imm 1; add $1 $2 $2
    jz $2 @main.nonComment
      jal @skipLine $2
      j @main.loop
    @main.nonComment:
    cmp $1 ' ' eq j @main.loop

    jal @fromHex $1
    shl 4 $2
    in $2
    jal @fromHex $2
    add $1 $2 $1

    out $1
    j @main.loop
  @main.loop.end
  syscall 0 0



@skipLine:

  in $1
  jneg $1 @skipLine.return
  cmp $1 '\n' eq j @skipLine.return
  j @skipLine
  @skipLine.return
  ret



@fromHex:
  cmp $1 '0' lt syscall 0 1
  cmp $1 '9' gt j @fromHex.alpha
  sub $1 '0' $1
  ret
  @fromHex.alpha
  cmp $1 'F' gte
    sub $1 {'a' - 'A'} $1

  cmp $1 'A' lt syscall 0 1
  cmp $1 'F' gt syscall 0 1
  sub $1 {'a' - 10} $1
  ret

