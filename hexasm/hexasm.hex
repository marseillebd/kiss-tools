      f000 # in r0(c)
    # if (c < 0) exit(0)
      c000 # cltz r0(c)
      f070 # hlt 0
    # if (c == end) return
      c091 # ceq r0(c) r1(end)
      ef87 # mov ip r7
  # }
    1f0C # j -12
# }
@skipThru.end =4C
                              0000_0000

