    ea39 # mov ra '9'
    c0ca # cgt r0 ra
    0f04 # j +4
  # {
    # c -= h30
      1030 # sub r0 h30
    # return c
      ef88 # mov ip r8
  # }
  # if (n < 'A') exit(1)
    ea41 # mov ra h41
    c0aa # clt r0 ra
    f071 # hlt 1
  # if (n >= 'F') exit(1)
    ea46 # mov ra h46
    c0ca # clt r0 ra
    f071 # hlt 1
  # c -= ('A' - 10)
    1037
  # return c
    ef88 # mov ip r8
# }
@=76
               0000 0000_0000 0000_0000

