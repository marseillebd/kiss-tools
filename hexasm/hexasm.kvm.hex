
# BUILDING
# sed 's/[#@;].*$//' hexasm.kvm.hex | tr -d $' \n_'
# use vim or smth to split into 16bit words and 16-byte lines, and add addresses
# prepend the kiss vm header
# xxd -r to create the binary

# header magic
6b73 766d 3130 300a    ; "ksvm100\n"
3038 7830 3033 320a    ; "08x0032\n"
# header meta
0000 0000 0000 0000    ; reserved
0000 0000              ; 0 data bytes
0000 0086              ; 86 code bytes


; .text

@0000 ; main: ---
  # loop {

  # c = getc()
  BC    ; in              # --- c

  # if c < 0 exit(0)
  80          ; dup        # c --- c c
  03 B6       ; jge(+3)    # c c --- c
  00 00 BE    ; exit(0)    # c --x

# skip comments
@0007
  # if
    #   (c == '#'
    80 23 A1         ; dup '#' sub    # c --- c c='#'
    0C B2            ; jeq(+12)       # c isComment --- c
    # || c == ';'
    80 3B A1         ; dup ';' sub    # c --- c c=';'
    07 B2            ; jeq(+7)        # c isComment --- c
    # || c == '@'
    80 40 A1         ; dup '@' sub    # c --- c c='@'
    02 B2            ; jeq(+2)        # c isComment --- c
  # )
  09 B7              ; j(main.notComment=+9)
@0018 ; main.isComment
    # {
    BA                 ; pop                # c ---
    # skip2line()
    AF 0000_0061 B7    ; call(skip2line)    # ---
    # continue
    DF B7              ; j(main=-33)
    # }
@0021 ; main.notComment

# try hex digit
  # if (b := fromHex(c))
    10 B7    ; call(fromHex=+16)    # c --- c nybble ok?
    04 B5    ; jne(.isHex=+4)       # c nybble ok? --- c nybble
  # else pass
    BA BA    ; pop pop              # c nybble ---
    D7 B7    ; jmp(main=-41)
# parse one byte
@0029 ; main.isHex
  # then {
    BB BA    ; xch pop              # c nybble --- nybble
    04 AE    ; shl(4)               # nybble   --- hi
    32 B7    ; call(readHex=+50)    # hi       --- hi lo
    A0       ; add                  # hi lo    --- byte
    # putc(b)
    BD       ; out                  # byte ---
  # }
@0031
  CD B7    ; j(main=-51)
  # }

@0033 ; fromHex: # c --- c b ok?
  # if (c < '0') return false
  80 30 A1    ; dup '0' sub    # c --- c c-'0'
  03 B6       ; jge(+3)        # c c-'0' --- c
  FF 00 B8    ; ret(-1, 0)     # c --- c _ false

  # if (c <= '9') return c - '0', true
  80 39 A1    ; dup '9' sub    # c --- c c-'9'
  05 B4       ; jgt(+5)        # c c-'9' --- c
  80 30 A1    ; dup '0' sub    # c --- c b
  01 B8       ; 1 ret          # c b --- c b true
@0045

  # if (c >= 'a') c -= ('a' - 'A')
  80 61 A1    ; dup 'a' sub    # c --- c c-'a'
  02 B1       ; jlt(+2)        # c c-'a' --- c/c.upper
  20 A1       ; 32 sub         # c --- c.upper

  # if (c < 'A') return false
  80 41 A1    ; dup 'A' sub    # c --- c c-'A'
  03 B6       ; jge(+3)        # c c-'A' --- c
  FF 00 B8    ; ret(0, -1)     # c --- c _ false
@0054

  # if (c > 'F') return false
  80 46 A1    ; dup 'F' sub    # c --- c c-'F'
  03 B3       ; jle(+3)        # c c-'F' --- c
  FF 00 B8    ; ret(0, -1)     # c --- c _ false

  # return c - 'A' + 10, true
  80 37 A1    ; dup ('A' - 10) sub    # c --- c b
  01 B8       ; true ret              # c b --- c b true
@0061

@0061 ; readHex: --- nybble
# prologue (save lp since this isn't a leaf call)
  00 B9 ; 0 slp # --- lp

# loop {
# c = getc
  BC ; in # lp --- lp c

# if (c < 0) exit(1)
  80 03 B6    ; dup jge(+3)      # lp c --- lp c
  01 00 BE    ; swi(exit, 1)     # lp c --x

# b := fromHex(c)
  C7 B7    ; call(fromHex=-57)    # lp c --- lp c nybble ok?
@006C
# if (ok)
  05 B2    ; jeq(.again=+5)       # lp c nybble ok? --- lp c nybble
# {
# return b
  BB BA       ; xch pop        # lp c nybble --- lp nybble
# epilogue (restoring lp)
  BB B9 BA    ; xch slp pop    # lp nybble --- nybble
  B8          ; ret
# }

@0074 ; readHex.again
# if (c != '_') exit(1)
  BA 80 5F A1    ; pop dup '_' sub    # lp c nybble --- lp c c='_'
  03 B2          ; jeq(+3)            # lp c c='_' --- lp c
  01 00 BE       ; swi(exit, 1)     # lp c --x

# }
  BA       ; pop    # lp c --- lp
  E3 B7    ; j(readHex+2=-29)
@0080 ; end loop


@0080 ; skip2line: ---
  BC 0A A1    ; in '\n' sub          # --- c!='\n'
  FB B5       ; jne(skip2line=-5)    # c!='\n' ---
  B8          ; ret

@0086
