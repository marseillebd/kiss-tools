cabal-version:      3.0
name:               kiss-experiments
version:            0.1.0.0
-- synopsis:
-- description:
license:            GPL-3.0-or-later
license-file:       LICENSE
author:             Marseille Bouchard Demko
maintainer:         marseillebd@proton.me
-- copyright:
build-type:         Simple
extra-doc-files:    CHANGELOG.md
-- extra-source-files:

common dialect
    ghc-options: -Wall
    default-language: Haskell2010
    build-depends:
      , base ^>=4.20.2.0
      , bytestring
      , containers
      , text
      , mtl
      , primitive

library
    import:           dialect
    hs-source-dirs:   src
    exposed-modules:
      HexObject
    -- other-modules:
    -- other-extensions:
    build-depends:

executable kiss-experiments
    import:           dialect
    hs-source-dirs:   app
    main-is:          Main.hs
    -- other-modules:
    -- other-extensions:
    build-depends:
        kiss-experiments

